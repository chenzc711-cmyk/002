<view class="container">
  <view class="card">
    <view class="section-title">{{form.id ? '编辑商品' : '添加库存商品'}}</view>
    <view class="form-grid">
      <view><text class="label">商品名称</text><input class="input" data-field="name" value="{{form.name}}" bindinput="onFormInput" placeholder="如：洗护套装" /></view>
      <view><text class="label">商品规格</text><input class="input" data-field="spec" value="{{form.spec}}" bindinput="onFormInput" placeholder="如：500ml" /></view>
      <view><text class="label">商品单价</text><input class="input" type="digit" data-field="price" value="{{form.price}}" bindinput="onFormInput" /></view>
      <view><text class="label">在库数量</text><input class="input" type="number" data-field="quantity" value="{{form.quantity}}" bindinput="onFormInput" /></view>
      <view><text class="label">供应商</text><picker range="{{suppliers}}" value="{{supplierIndex}}" bindchange="onSupplierChange"><view class="picker-display">{{form.supplier || '请选择供应商'}}</view></picker></view>
      <view><text class="label">预警数量</text><input class="input" type="number" data-field="warningQty" value="{{form.warningQty}}" bindinput="onFormInput" /></view>
      <view class="full"><text class="label">备注</text><textarea data-field="remark" value="{{form.remark}}" bindinput="onFormInput" placeholder="可填写渠道、批次等信息" /></view>
    </view>
    <button class="primary-btn" bindtap="saveInventory">保存商品</button>
    <button wx:if="{{form.id}}" class="ghost-btn" bindtap="resetForm">取消编辑</button>
  </view>

  <view class="card balance-card">
    <view class="section-title">供应商货款余额</view>
    <picker range="{{suppliers}}" value="{{balanceSupplierIndex}}" bindchange="onBalanceSupplierChange"><view class="picker-display">{{balanceForm.supplier}}</view></picker>
    <input class="input" type="digit" data-field="amount" value="{{balanceForm.amount}}" bindinput="onBalanceInput" placeholder="输入该供应商货款余额" />
    <button class="primary-btn" bindtap="saveBalance">保存余额</button>
    <view class="balance-list">
      <view wx:for="{{balanceList}}" wx:key="supplier" class="balance-row"><text>{{item.supplier}}</text><text>¥{{item.amountText}}</text></view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">库存列表</view>
    <view class="toolbar"><button class="ghost-btn" bindtap="selectAll">全选</button><button class="danger-btn" bindtap="clearSelection">取消选择</button></view>
    <checkbox-group bindchange="onSelectChange">
      <label wx:for="{{inventory}}" wx:key="id" class="list-item">
        <view class="item-head">
          <checkbox value="{{item.id}}" checked="{{item.checked}}" />
          <view class="item-title">{{item.name}}｜{{item.spec}}</view>
          <button size="mini" class="ghost-btn mini" data-id="{{item.id}}" bindtap="editInventory">编辑</button>
        </view>
        <view class="item-meta">
          <text class="badge">{{item.supplier}}</text>单价 ¥{{item.price}} · 在库 {{item.quantity}} · 预警 {{item.warningQty}}
          <view>{{item.remark}}</view>
        </view>
      </label>
    </checkbox-group>
  </view>
</view>
