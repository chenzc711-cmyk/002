page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff5f7 0%, #f7f8fb 42%, #f5f5f5 100%);
  color: #222222;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  text-align: center;
}

.container {
  padding: 28rpx;
  box-sizing: border-box;
}

.card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 48rpx rgba(255, 0, 54, 0.10);
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 0, 54, 0.08);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #1f1f1f;
  letter-spacing: 1rpx;
  text-align: center;
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 10rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff0036, #ff7a45);
  margin-right: 14rpx;
}

.input, .picker-display, textarea {
  width: 100%;
  min-height: 78rpx;
  background: #fff7f8;
  border: 1rpx solid #ffd9e1;
  border-radius: 18rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-bottom: 18rpx;
  text-align: center;
}

textarea {
  padding-top: 18rpx;
  min-height: 120rpx;
  line-height: 1.6;
}

.label {
  display: block;
  color: #666666;
  font-size: 24rpx;
  margin: 8rpx 0 10rpx;
  text-align: center;
  letter-spacing: 1rpx;
}

.primary-btn, .ghost-btn, .danger-btn {
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 76rpx;
  height: 76rpx;
  margin: 14rpx 0;
}

.primary-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #ff0036 0%, #ff6a00 100%);
  box-shadow: 0 12rpx 28rpx rgba(255, 0, 54, 0.22);
}

.ghost-btn {
  color: #ff0036;
  background: #fff0f3;
  border: 1rpx solid #ffc2cf;
}

.danger-btn {
  color: #ffffff;
  background: #222222;
}

.list-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f1f1f1;
  text-align: center;
}

.list-item:last-child {
  border-bottom: 0;
}

.item-head {
  display: grid;
  grid-template-columns: 72rpx 1fr 128rpx;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
  text-align: center;
}

.item-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #222222;
  text-align: center;
  line-height: 1.4;
}

.item-meta {
  font-size: 24rpx;
  color: #777777;
  line-height: 1.8;
  text-align: center;
}

.badge {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  background: #fff0f3;
  color: #ff0036;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.toolbar {
  display: flex;
  gap: 16rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.toolbar button {
  flex: 1;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 18rpx;
}

.full {
  grid-column: 1 / -1;
}


.picker-display {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333333;
}

button {
  text-align: center;
}
